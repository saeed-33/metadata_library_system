{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LibrarySystemDataBas;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "IdentifyConnection": "Server=localhost;Database=IdentifyConnectionDataBase;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

  },
  "JwtSettings": {
    "SecretKey": "Your_Super_Secret_Key_At_Least_32_Characters_Long",
    "Issuer": "LibrarySystem",
    "Audience": "LibrarySystemUsers",
    "ExpiryInMinutes": 60
  },
  "MediaSettings": {
    "StoragePath": "wwwroot/uploads",
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [ ".jpg", ".png", ".pdf", ".docx" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}